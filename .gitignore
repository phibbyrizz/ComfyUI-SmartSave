# ============================================================
# ComfyUI-SmartSave
# Local/development files that should not be committed
# ============================================================


# ------------------------------------------------------------
# Python-generated files
# ------------------------------------------------------------

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/


# ------------------------------------------------------------
# Virtual environments / local environment configuration
# ------------------------------------------------------------

.env
.env.*
.venv/
venv/
env/

# Local machine configuration.
config_local.py


# ------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------

.vscode/
.idea/
.cursorignore
.cursorindexingignore


# ------------------------------------------------------------
# Personal SmartSave configuration/data
# ------------------------------------------------------------

# Personal subject aliases
aliases.json
aliases.local.json

# Local caches
prompt_cache.json
*.cache.json


# ------------------------------------------------------------
# Local maintenance / diagnostic utilities
# ------------------------------------------------------------

inspect_meta.py
prune_empty.py
recover.py

# Legacy sorter - superseded by auto_sort.py
total_resort.py
run_total_resort*


# ------------------------------------------------------------
# Auto-Sort generated reports
# ------------------------------------------------------------

auto_sort_preview*.json
auto_sort_apply_plan*.json
auto_sort_report*.json


# ------------------------------------------------------------
# Temporary development / release-candidate files
# ------------------------------------------------------------

auto_sort_TEST*.py
auto_sort_RC*.py

SMARTSAVE_TEST*.txt
RC_NOTES.txt
README_FIRST.txt

run auto sort TEST*.bat
run auto sort RC*.bat


# ------------------------------------------------------------
# Generated media / accidental test output
# ------------------------------------------------------------

*.png
*.jpg
*.jpeg
*.webp
*.webm
*.mp4
*.mov
*.mkv


# ------------------------------------------------------------
# Build / distribution artifacts
# ------------------------------------------------------------

build/
dist/
*.egg-info/

# Don't commit packaged copies / ad-hoc archives.
*.zip


# ------------------------------------------------------------
# Operating-system junk
# ------------------------------------------------------------

Thumbs.db
thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
